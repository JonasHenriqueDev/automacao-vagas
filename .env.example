# Copie para .env (ignorado pelo git; na VM: chmod 600, dono = usuário do serviço).
# Gere as duas primeiras com: python -m app gerar-chave
CHAVE_MESTRA=
SEGREDO_SESSAO=

# Chaves de LLM (planos gratuitos). Também podem ser cadastradas pelo painel (criptografadas).
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=

# Token do GitHub só de leitura, sem escopos (sobe o limite da API de 60 para 5000 req/h)
GITHUB_TOKEN=

# Webhook de um canal do Discord para as notificações
DISCORD_WEBHOOK_URL=

# Senha de app da conta de e-mail dos alertas
EMAIL_SENHA=
